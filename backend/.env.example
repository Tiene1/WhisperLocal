# ─── Base de données ───────────────────────────────────────────────
DATABASE_URL="postgresql://whisperlocal:whisperlocal@localhost:5432/whisperlocal?schema=public"

# ─── Serveur ────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:3001

# ─── whisper.cpp ────────────────────────────────────────────────────
# Chemin vers le binaire whisper.cpp compilé (ex: whisper-cli, main, ou build/bin/main)
WHISPER_CPP_BINARY_PATH=/usr/local/bin/whisper-cli
# Dossier contenant les modèles ggml (ex: ggml-medium.bin)
WHISPER_MODELS_DIR=/models

# ─── ffmpeg / ffprobe ───────────────────────────────────────────────
FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
FFPROBE_BINARY_PATH=/usr/bin/ffprobe

# ─── Fichiers temporaires ───────────────────────────────────────────
# Dossier de travail pour les fichiers audio uploadés et convertis
UPLOAD_TMP_DIR=/tmp/whisperlocal-uploads
# Taille maximale d'un fichier audio en Mo
MAX_UPLOAD_SIZE_MB=250

# ─── Diarisation (optionnelle) ──────────────────────────────────────
# URL interne du service Python de diarisation (voir README, section
# "Diarisation (optionnelle)"). Fonctionnalité opt-in, jamais bloquante :
# si ce service est indisponible, la transcription classique continue.
DIARIZATION_SERVICE_URL=http://diarization:8001
