# Token Hugging Face — requis UNIQUEMENT si tu utilises la diarisation
# (identification des locuteurs, opt-in). Voir README section
# "Diarisation (optionnelle)" pour la procédure complète (compte HF,
# acceptation des conditions sur les 2 modèles gated, génération du token).
# Sans cette variable, le reste de l'application fonctionne à l'identique.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de l'API telle que résolue par le NAVIGATEUR de l'utilisateur (voir
# docker-compose.yml, service frontend) — à adapter si tu changes le port
# hôte de l'API (actuellement 3010, remappé pour éviter un conflit local).
NEXT_PUBLIC_API_URL=http://localhost:3010

# Port hôte exposé pour le service frontend Next.js.
MAX_UPLOAD_SIZE_MB=250
CORS_ORIGIN=http://localhost:3001
